<% layout("/layouts/boilerplate") %>
<style>
  #filters{
    display: flex;
  }

  .filter{
    text-align: center;
    margin-right:2rem;
    margin-top: 1rem;
    opacity:0.7;

  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }
</style>

  <div id="filters">
    <div class="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-city"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-hippo"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Trending</p>
    </div>

    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="flexswitchCheckDefault">
  <label class="form-check-label" for="flexswitchCheckDefault">Display total after taxes</label>
</div>
    </div>
  </div>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
      <% for(let list of allListings) {%>
        <a href="/listings/<%= list._id %>" class="listing-link">
    <div class="card listing-card">
    <img src="<%= list.image.url %>" 
    class="card-img-top" 
    alt="listing_image" 
    style="height: 20rem;">
    <div class="card-img-overlay"></div>
    <div class="card-body">
      <b><p class="card-text"><%= list.title %></b>
        
        <br>
        &#8377;<%=list.price.toLocaleString("en-IN")%>/Night
      </p>
    </div>
    </div>
  </a>
  <% } %>
  </div>
  

  <script>
    let  taxSwitch=document.getElementById("flexswitchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
      console.log("clicked");
    })
  </script>