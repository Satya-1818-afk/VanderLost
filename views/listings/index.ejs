<% layout("/layouts/boilerplate") %>

  <h3>ALL APP LISTINGSSSS:</h3>  
  <!-- <form action="/listings/new">
    <button>Add new</button>
  </form> -->

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
      <% for(let list of allListings) {%>
        <a href="/listings/<%= list._id %>" class="listing-link">
    <div class="card">
    <img src="<%= list.image.url %>" 
    class="card-img-top" 
    alt="listing_image" 
    style="height: 20rem;">
    <div class="card-img-overlay"></div>
    <div class="card-body">
      <b><p class="card-text"><%= list.title %></b>
        
        <br>
        &#8377;<%=list.price%>/Night
      </p>
    </div>
    </div>
  </a>
  <% } %>
  </div>
  